# JusticeNow server environment variables.
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is gitignored for a reason.

# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=your-project-url
SUPABASE_KEY=your-anon-key

# Port the Express API listens on
PORT=5000

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:3000

# Secret used to sign staff session JWTs. MUST be set — the server refuses to
# start without it. Use a long, random value in production; never reuse this
# placeholder. Rotating it invalidates all existing staff sessions.
JWT_SECRET=change-me-in-production
