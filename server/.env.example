# JusticeNow server environment variables.
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is gitignored for a reason.

# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=your-project-url
SUPABASE_KEY=your-anon-key

# Port the Express API listens on
PORT=5000

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:3000

# Secret used to sign staff session JWTs. MUST be set — the server refuses to
# start without it. Use a long, random value in production; never reuse this
# placeholder. Rotating it invalidates all existing staff sessions.
JWT_SECRET=change-me-in-production

# AI Legal Guidance (Anthropic). Server-side ONLY — never expose to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Map place search (Google Places API "New"). Server-side ONLY — the app never
# sees this key; the client calls /api/places/* and the server calls Google.
# OPTIONAL: if unset, the map search falls back to the basic on-device geocoder.
# Enable "Places API (New)" in Google Cloud, create an API key, and restrict it
# to that API. Billing is required (Maps Platform has a monthly free credit).
GOOGLE_PLACES_API_KEY=

# Voice-report transcription (Google Cloud Speech-to-Text), proxied server-side so
# the key never ships in the app. OPTIONAL: if unset, voice reports are still
# recorded and submitted — they just aren't auto-transcribed into text.
# Enable "Cloud Speech-to-Text API" in Google Cloud. You can reuse the Places key
# above IF it is unrestricted (or its API restrictions include speech.googleapis.com);
# otherwise set a dedicated key here. If both are unset, transcription is disabled.
GOOGLE_SPEECH_API_KEY=

# Staff 2FA email codes (Gmail SMTP). OPTIONAL — only needed if any staff member
# chooses the "email code" 2FA method (authenticator-app 2FA works without this).
# SMTP_USER is the sending Gmail address. SMTP_PASS MUST be a Gmail APP PASSWORD
# (Google Account -> Security -> 2-Step Verification -> App passwords), never the
# real account password. SMTP_FROM is the visible sender; defaults to SMTP_USER.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
