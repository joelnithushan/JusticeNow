# Expo/React Native pins react to the exact version that ships with the SDK
# (react 19.2.3 for SDK 57 / RN 0.86). Some transitive web deps pulled in by
# expo-router (react-dom, radix) declare a slightly newer react peer range,
# which makes npm's strict peer resolver fail. legacy-peer-deps tells npm to
# install anyway — this is the recommended setting for Expo projects and lets
# every teammate run `npm install` without extra flags.
legacy-peer-deps=true
