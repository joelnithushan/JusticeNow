{
  "expo": {
    "name": "JusticeNow",
    "slug": "justicenow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "justicenow",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justicenow.app"
    },
    "android": {
      "package": "com.justicenow.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b3d5c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A3559"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "JusticeNow uses your photo library only so you can choose a profile picture. Images are not linked to any case.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "JusticeNow uses the camera only to scan your case QR code. No photo is taken or stored.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JusticeNow can center the map on your area to help you pick an incident location. Your location is never tracked or stored — only the place name you choose is saved."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "JusticeNow saves your case QR code to your photos so you can keep it safely.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "JusticeNow uses the microphone to let you record a voice report instead of typing."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22c60837-ffd4-41be-8685-a2c67b6b5470"
      }
    },
    "owner": "joel0610"
  }
}
