{
  "expo": {
    "name": "JusticeNow",
    "slug": "justicenow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "justicenow",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justicenow.app"
    },
    "android": {
      "package": "com.justicenow.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b3d5c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A3559"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "JusticeNow uses your photo library only so you can choose a profile picture. Images are not linked to any case.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "JusticeNow uses the camera only to scan your case QR code. No photo is taken or stored.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JusticeNow can center the map on your area to help you pick an incident location. Your location is never tracked or stored — only the place name you choose is saved."
        }
      ]
    ]
  }
}
