# JusticeNow (mobile) — environment variables.
#
# Copy this file to ".env" and set the value below, then restart `expo start`.
#   cp .env.example .env
#
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the app at build
# time, so it is readable via process.env.EXPO_PUBLIC_API_URL (see
# src/api/client.ts).
#
# IMPORTANT — localhost will NOT work on a physical phone.
# "localhost" on the phone means the phone itself, not your computer. You must
# put your COMPUTER'S LAN IP address here, and the phone and the computer must
# be on the SAME Wi-Fi network.
#
# Find your computer's LAN IP:
#   macOS:   ipconfig getifaddr en0
#   Windows: ipconfig  (look for "IPv4 Address")
#   Linux:   hostname -I
#
# Then replace 192.168.1.X below with that address. Keep the ":5000/api" suffix
# (5000 is the Express server's port; /api is the route prefix).
EXPO_PUBLIC_API_URL=http://192.168.1.X:5000/api
